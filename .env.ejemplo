# Copie este archivo como ".env" en su computadora y complete los valores.
# El archivo ".env" NO se sube al repositorio (está en .gitignore).

# Base de datos (opcional en local; si está vacía se usa certificados.db)
DATABASE_URL=

# Clave que firma la cookie de sesión del login
SECRET_KEY=

# Usuario administrador
ADMIN_CORREO=
ADMIN_CLAVE=

# Usuario normal
USUARIO_CORREO=
USUARIO_CLAVE=

# Valores de DEMOSTRACIÓN (solo si las variables de arriba no existen):
#   ADMIN_CORREO=admin@academia.cr      ADMIN_CLAVE=admin123
#   USUARIO_CORREO=usuario@academia.cr  USUARIO_CLAVE=usuario123
